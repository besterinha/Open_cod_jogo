{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "godot": {
      "type": "local",
      "command": ["npx", "-y", "@coding-solo/godot-mcp"],
      "enabled": true
    },
    "godot-docs": {
      "type": "local",
      "command": ["npx", "-y", "@nuskey8/godot-docs-mcp"],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "context7", "serve"],
      "enabled": true
    }
  },
  "instructions": ["AGENTS.md", "docs/GDD.md", "docs/TDD.md", "docs/WORKFLOW.md"],
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "*": "allow",
      "git push --force*": "ask",
      "git push -f*": "ask"
    },
    "task": {
      "*": "allow",
      "general": "ask"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "question": "allow",
    "todowrite": "allow",
    "external_directory": "allow",
    "doom_loop": "allow",
    "lsp": "allow"
  },
  "agent": {
    "build": {
      "permission": {
    "edit": {
      "*": "allow",
      "data/**/*.tres": "ask",
      "data/*/*.tres": "ask",
      "data/*.tres": "ask",
          "tests/**": "ask",
          "tests/*": "ask",
          "opencode.json": "ask",
          ".opencode/**": "ask",
          ".opencode/*": "ask"
        }
      }
    }
  }
}

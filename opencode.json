{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "godot": {
      "type": "local",
      "command": ["npx", "-y", "@coding-solo/godot-mcp"],
      "enabled": true
    },
    "godot-docs": {
      "type": "local",
      "command": ["npx", "-y", "@nuskey8/godot-docs-mcp"],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "context7", "serve"],
      "enabled": true
    }
  },
  "instructions": ["AGENTS.md", "docs/GDD.md", "docs/TDD.md"],
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "question": "allow",
    "todowrite": "allow",
    "external_directory": "allow",
    "doom_loop": "allow",
    "lsp": "allow"
  }
}

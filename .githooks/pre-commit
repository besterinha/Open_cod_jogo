#!/bin/bash
# Porta fechada no fluxo local — recusa commit se testes não passarem (rápido, <15s)
set -e
echo "pre-commit: style + file-coverage + contract+unit (rápido)"
# ETAPA 1 Gate 0 estático — ordem: Tab/LF → gdlint BLOQ → gdformat AVISO → check-only BLOQ
# style Tab (instant) — bloqueia se encontrar 4 espaços após tab
if grep -rn "^\t*    " --include="*.gd" systems/ ui/ content/ 2>/dev/null | grep -q .; then
  echo "pre-commit: indent com espaços, use Tab"
  grep -rn "^\t*    " --include="*.gd" systems/ ui/ content/ 2>/dev/null | head -n 5
  exit 1
fi
# gdlint BLOQUEANTE (ETAPA 1)
echo "pre-commit: Gate 0 gdlint (BLOQUEANTE)..."
if command -v gdlint >/dev/null 2>&1; then
  gdlint systems/ content/ tests/ > /tmp/gdlint.log 2>&1 || true
  GDLINT_EXIT=$?
  cat /tmp/gdlint.log
  if grep -q "Failure:" /tmp/gdlint.log 2>/dev/null; then
    echo "pre-commit: gdlint falhou (bloqueante ETAPA 1)"
    exit 1
  fi
  echo "pre-commit: gdlint ok"
else
  echo "pre-commit: gdlint não instalado, pulando (instale gdtoolkit 4.5.0)"
fi
# gdformat AVISO apenas (ETAPA 1) — mostra diff em amarelo, não bloqueia
echo "pre-commit: Gate 0 gdformat (AVISO, não bloqueia ETAPA 1)..."
if command -v gdformat >/dev/null 2>&1; then
  gdformat --check systems/ content/ tests/ > /tmp/gdformat.log 2>&1 || true
  cat /tmp/gdformat.log | head -n 20
  if grep -q "would reformat" /tmp/gdformat.log 2>/dev/null; then
    echo -e "\033[33mpre-commit: gdformat AVISO — diff encontrado (ETAPA 1 não bloqueia, ETAPA 2 bloqueará)\033[0m"
    echo -e "\033[33mDica: rode gdformat systems/ content/ tests/ para ver diff completo (ETAPA 2 alinhará config)\033[0m"
  else
    echo "pre-commit: gdformat ok"
  fi
else
  echo "pre-commit: gdformat não instalado"
fi
# godot --check-only BLOQUEANTE (sintaxe) — usa timeout+head para não travar (godot hang com redirect)
echo "pre-commit: Gate 0 check-only (BLOQUEANTE)..."
timeout 20 godot --headless --check-only 2>&1 | head -n 100 > /tmp/check.log || true
cat /tmp/check.log | head -n 20
if grep -q "ERROR" /tmp/check.log 2>/dev/null; then
  echo "pre-commit: check-only falhou (bloqueante)"
  cat /tmp/check.log
  exit 1
fi
echo "pre-commit: check-only ok"
# file-coverage (instant) — geral (BASE_REF) + staged per-commit visível
bash ci/check-file-coverage.sh 2>&1 | tail -n 5 || { echo "pre-commit: file-coverage falhou"; exit 1; }
STAGED_SYS=$(git diff --cached --name-only --diff-filter=AM 2>/dev/null | grep -E '^systems/.*\.gd$' || true)
STAGED_TEST=$(git diff --cached --name-only --diff-filter=AM 2>/dev/null | grep -E '^tests/.*\.gd$' || true)
if [ -n "$STAGED_SYS" ] && [ -z "$STAGED_TEST" ]; then
  echo "pre-commit file-coverage STAGED: systems/*.gd mudou sem tests/*.gd (STAGED)"
  echo "$STAGED_SYS" | head -n 10
  exit 1
fi
# A5: docs atualizados se systems/ui mudou — checa STAGED (per-commit) visível
CHANGED_SYS_STAGED=$(git diff --cached --name-only --diff-filter=AM 2>/dev/null | grep -E '^systems/.*\.gd$|^ui/.*\.gd$' || true)
CHANGED_DOCS_STAGED=$(git diff --cached --name-only --diff-filter=AM 2>/dev/null | grep -E '^docs/.*\.md$' || true)
if [ -n "$CHANGED_SYS_STAGED" ] && [ -z "$CHANGED_DOCS_STAGED" ]; then
  echo "pre-commit A5: STAGED systems/ui mudou mas docs/*.md não mudou"
  echo "$CHANGED_SYS_STAGED" | head -n 10
  echo "Atualize docs/GDD.md + docs/TDD.md + docs/STYLE.md (AGENTS.md:58) ou git commit --no-verify (bypass visível)"
  exit 1
fi
# também checa último commit vs HEAD caso pre-commit seja chamado após commit (CI)
git fetch origin main --quiet 2>/dev/null || true
BASE_REF=$(git merge-base origin/main HEAD 2>/dev/null || echo "HEAD~1")
if ! git rev-parse --verify $BASE_REF >/dev/null 2>&1; then BASE_REF=HEAD~1; fi
CHANGED_SYS=$(git diff --name-only --diff-filter=AM $BASE_REF...HEAD 2>/dev/null | grep -E '^systems/.*\.gd$|^ui/.*\.gd$' || true)
CHANGED_DOCS=$(git diff --name-only --diff-filter=AM $BASE_REF...HEAD 2>/dev/null | grep -E '^docs/.*\.md$' || true)
# não bloqueia aqui se BASE_REF antigo contém docs antigos (falso-positivo), apenas log
if [ -n "$CHANGED_SYS" ] && [ -z "$CHANGED_DOCS" ]; then
  echo "pre-commit A5 (CI): BASE $BASE_REF tem systems sem docs, mas STAGED ok — aviso"
fi
# C8: pirâmide 70/25/5 checagem visível (não bloqueia 100%, mas avisa se regression faltar)
if [ ! -n "$(ls tests/regression/test_regression_bug_*.gd 2>/dev/null)" ]; then
  echo "pre-commit C8: nenhum test_regression_bug_*.gd encontrado — crie regression para cada bug"
  # não bloqueia ainda, só avisa visível (descomente exit 1 para travar)
fi
COUNT_U=$(find tests/unit -name "*.gd" 2>/dev/null | wc -l)
COUNT_I=$(find tests/integration -name "*.gd" 2>/dev/null | wc -l)
echo "pre-commit: pirâmide $COUNT_U unit / $COUNT_I integration (C8 70/25 alvo)"
# contract+unit juntos (headless, ~5s) — integration fica para pre-push/CI para não travar commit
godot --headless --script addons/gut/gut_cmdln.gd -gdir=res://tests/contract -gdir=res://tests/unit -gexit 2>&1 | tail -n 10 || { echo "pre-commit: contract/unit falhou"; exit 1; }
echo "pre-commit: tudo verde, commit liberado"
# Nota: integration + smoke+e2e rodam no pre-push e no CI, não aqui, para manter commit rápido
